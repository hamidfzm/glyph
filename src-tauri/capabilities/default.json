{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri/v2/crates/tauri-utils/schema/capability.json",
  "identifier": "default",
  "description": "Default capabilities for Glyph. The dialog, fs, and store plugins get the exact commands the frontend calls, never their default sets, which resolve renderer-supplied paths (see docs/security/threat-model.md).",
  "windows": ["main", "w*"],
  "permissions": [
    "core:default",
    "core:app:allow-set-app-theme",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-is-fullscreen",
    "dialog:allow-message",
    "os:default",
    "clipboard-manager:allow-read-text",
    "store:allow-get-store",
    "store:allow-get",
    "store:allow-set",
    "store:allow-delete",
    "store:allow-entries",
    "store:allow-length",
    "store:allow-save",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://raw.githubusercontent.com/glyph-md/*" },
        { "url": "https://github.com/glyph-md/*" },
        { "url": "https://release-assets.githubusercontent.com/*" },
        { "url": "https://objects.githubusercontent.com/*" }
      ]
    }
  ]
}
