<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the app's generated Info.plist by Tauri. macOS types only .md
     and .markdown as markdown (net.daringfireball.markdown); this names the
     rest of the markdown extensions in tauri.conf.json so the Quick Look
     extension (macos/quicklook) can claim them. -->
<plist version="1.0">
<dict>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.hamidfzm.glyph.markdown</string>
			<key>UTTypeDescription</key>
			<string>Markdown Document</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>net.daringfireball.markdown</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>mdown</string>
					<string>mkd</string>
					<string>mkdn</string>
					<string>mdx</string>
					<string>mmd</string>
					<string>mdtext</string>
					<string>mdtxt</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
