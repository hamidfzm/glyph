[Desktop Entry]
Categories={{categories}}
{{#if comment}}
Comment={{comment}}
{{/if}}
Exec={{exec}} %F
StartupWMClass={{exec}}
Icon={{icon}}
Name={{name}}
Terminal=false
Type=Application
# Written out, not rendered from fileAssociations: the D2 association's
# text/plain would offer Glyph for every text file. glyph.xml defines these.
MimeType=text/markdown;text/x-d2;
