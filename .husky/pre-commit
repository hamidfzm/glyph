# Pre-commit gate. Runs every check CI runs so a green commit is a green
# PR build. Expect roughly 1–2 minutes on a clean working tree; the fast
# parts (lint-staged) gate the slow parts so a formatter miss fails in
# seconds before the whole suite kicks off.
#
# Steps:
#   1. lint-staged: Biome on staged JS/TS/CSS (auto-fix + re-stage),
#      `cargo fmt --check` once if any Rust file is staged.
#   2. pnpm typecheck (tsc --noEmit)
#   3. pnpm test --run (full vitest suite)
#   4. cargo test --workspace --lib (Rust unit tests)
#   5. cargo clippy --workspace --all-targets -- -D warnings
#
# Steps 3 to 5 are the heavy ones, so they take a turn in the machine-wide
# queue (scripts/test-queue.sh): commits made from several worktrees at once
# run them one after another. The hook gets there by running itself again
# through the queue, with `heavy` as its argument.
#
# To bypass in a genuine emergency: `git commit --no-verify`. Don't make
# a habit of it. CI runs the same gate and will reject the PR.

set -e

if [ "${1:-}" != heavy ]; then
  # 1. Per-file frontend format/lint via Biome + workspace-level cargo fmt
  #    --check when any Rust file is staged. See .lintstagedrc.mjs.
  pnpm exec lint-staged

  # 2. Type-check the frontend.
  echo "→ pnpm typecheck"
  pnpm typecheck

  # The queue script beside this hook, not the committing worktree's: with a
  # shared hooks path this file also runs for branches that predate the script.
  queue="$(dirname "$0")/../scripts/test-queue.sh"
  branch=$(git symbolic-ref --short -q HEAD || echo "a detached HEAD")
  exec bash "$queue" "commit on $branch" -- sh -e "$0" heavy
fi

# 3. Frontend tests.
echo "→ pnpm test --run"
pnpm test --run

# 4. Rust unit tests.
echo "→ cargo test --workspace --lib (src-tauri)"
(cd src-tauri && cargo test --workspace --lib)

# 5. Clippy with warnings denied.
echo "→ cargo clippy --workspace --all-targets -- -D warnings (src-tauri)"
(cd src-tauri && cargo clippy --workspace --all-targets -- -D warnings)
